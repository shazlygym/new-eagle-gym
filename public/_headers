# Cloudflare Pages reads this file from the build output — it ignores
# netlify.toml entirely. Without no-cache on sw.js and index.html the CDN keeps
# serving the old service worker and deployed updates never reach a phone that
# already has the app installed. Hashed assets are safe to pin for a year.

/sw.js
  Cache-Control: no-cache, must-revalidate

/index.html
  Cache-Control: no-cache, must-revalidate

/manifest.webmanifest
  Cache-Control: no-cache

# Proves to Android that the packaged app and this site are the same product.
# Never cache it: the fingerprint has to change the day Play re-signs the app,
# and a stale copy puts the browser address bar back on top of the app.
/.well-known/assetlinks.json
  Content-Type: application/json
  Cache-Control: no-cache, must-revalidate

/assets/*
  Cache-Control: public, max-age=31536000, immutable
